    { "id": "wave", "label": "Wave", "keys": "ControlRight+F9", "sign": "sc-wave", "screen": 2 },
    { "id": "salute", "label": "Salute", "keys": "ControlRight+F10", "sign": "sc-salute", "screen": 2 },
    { "id": "sit", "label": "Sit", "keys": "ControlRight+F11", "sign": "sc-sit", "screen": 2 },
    { "id": "clap", "label": "Clap", "keys": "ControlRight+KeyO", "sign": "sc-clap", "screen": 2 },
    { "id": "laugh", "label": "Laugh", "keys": "ControlRight+KeyB", "sign": "sc-laugh", "screen": 2 },
    { "id": "dance", "label": "Dance", "keys": "ControlRight+KeyY", "sign": "sc-dance", "screen": 2 }
